# ---------------------------------------------------------------------------
# Required. Any long random string. Signs the login cookie.
# Generate one with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Optional. Unlocks the area-manager view at /admin, which sees every store.
#
# Leave this blank and /admin stays shut on this deployment — it fails closed,
# so a missing value never means "open to everyone".
#
# Do NOT reuse a store's 4-digit code here. This one view exposes all 20
# stores, so make it long:  openssl rand -hex 16
# ---------------------------------------------------------------------------
ADMIN_CODE=

# ---------------------------------------------------------------------------
# Google Sheets backend.
#
# Leave GOOGLE_SHEET_ID blank and the app runs off the bundled snapshot in
# /data — good for a first look, but status updates will NOT persist.
# Fill all three in and the app reads and writes your Sheet.
# ---------------------------------------------------------------------------
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the whole private key including the BEGIN/END lines, wrapped in quotes.
# Keep the literal \n escapes exactly as they appear in the JSON key file.
GOOGLE_PRIVATE_KEY=""
